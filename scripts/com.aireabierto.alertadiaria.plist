<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aireabierto.alertadiaria</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/francobmassi/Documents/GitHub/AireAbierto-CalidadAire-AMBA/.venv/bin/python</string>
    <string>/Users/francobmassi/Documents/GitHub/AireAbierto-CalidadAire-AMBA/scripts/update_daily.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/francobmassi/Documents/GitHub/AireAbierto-CalidadAire-AMBA</string>

  <!-- Las credenciales (FIRMS_MAP_KEY, SMTP) las lee update_daily.py desde .env
       en el WorkingDirectory: no se ponen acá. -->

  <!-- Corre todos los días a las 08:00. Cambiá Hour/Minute para otra hora. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/francobmassi/Documents/GitHub/AireAbierto-CalidadAire-AMBA/data/alerta_diaria.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/francobmassi/Documents/GitHub/AireAbierto-CalidadAire-AMBA/data/alerta_diaria.log</string>
</dict>
</plist>
